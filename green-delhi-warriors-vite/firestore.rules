rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{id}        { allow read: if signedIn() && request.auth.uid == id; allow write: if false; }
    match /warriors/{id}      { allow read: if signedIn();
                                allow create, update, delete: if signedIn() && (request.auth.uid == id || isAdmin()); }
    match /tolis/{id}         { allow read, write: if signedIn(); }
    match /announcements/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /site/{id}          { allow read: if true; allow write: if isAdmin(); }
  }
}
